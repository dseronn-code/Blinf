    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.90.2",
    "bcryptjs": "^2.4.3",
    "bwip-js": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fast-xml-parser": "^4.5.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "next-auth": "^4.24.11",
    "node-forge": "^1.3.1",
    "nodemailer": "^6.10.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",

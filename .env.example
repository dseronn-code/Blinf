DATABASE_URL="postgresql://gestao:gestao@localhost:5432/gestaopro?schema=public"
NEXTAUTH_SECRET="troque-este-segredo-em-producao"
NEXTAUTH_URL="http://localhost:3000"
# Hosts adicionais do ERP (vírgula). Qualquer outro host é tratado como domínio próprio de loja virtual
APP_HOSTS=""
# Opcional: habilita o Assistente de IA com Claude (sem a chave, usa o motor local de intenções)
ANTHROPIC_API_KEY=""
# Webhooks: true = não chama URLs externas (entregas simuladas)
WEBHOOKS_SIMULATE_ONLY="true"
# E-mail real via SMTP (opcional). Sem SMTP_HOST as mensagens ficam na caixa de saída como SIMULADO
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="GestãoPro <nao-responda@gestaopro.local>"
# Contador: recebe XML/DANFE das notas autorizadas (automação ENVIAR_DANFE_CLIENTE)
ACCOUNTANT_EMAIL=""
# Reforma tributária (2026, informativo)
CBS_RATE="0.9"
IBS_RATE="0.1"
# API v1: requisições por minuto por chave
API_RATE_LIMIT="120"
# true = não inicia o worker da fila de tarefas neste processo
DISABLE_WORKER="false"
